# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- LLM (OpenRouter por defecto) ---
# Cambiar de modelo = cambiar LLM_MODEL, sin tocar código.
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
# Opcional. Cualquier endpoint compatible con OpenAI chat-completions.
# LLM_API_URL=https://openrouter.ai/api/v1

# --- Servidor / panel ---
# Contraseña que pide el panel (header x-api-token). Generar con: openssl rand -hex 24
AUTOMATION_API_TOKEN=
# Opcional. Orígenes permitidos por CORS, separados por coma.
# ALLOWED_ORIGINS=http://localhost:3000
# Opcional.
# PORT=3000

# --- Alertas de error ---
# Email que recibe los errores (vía formsubmit.co).
ALERT_EMAIL=