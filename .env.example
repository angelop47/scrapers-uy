# Configuración para alertas por correo (FormSubmit)
ALERT_EMAIL=correo-destino@ejemplo.com

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key

# Protege la ejecución manual de scrapers y la lectura de logs.
# Generá un valor aleatorio largo; no lo publiques ni lo expongas en frontend público.
AUTOMATION_API_TOKEN=
# Orígenes permitidos, separados por coma.
ALLOWED_ORIGINS=http://localhost:3000

# Para Groq
IA_TOKEN=

# Para Gemini
GEMINI_TOKEN=

# Para MiniMax M3 (opcional, sólo si usás los scrapers minimax-*)
# Endpoint por defecto: https://api.minimaxi.chat/v1/chat/completions
# Modelo por defecto: MiniMax-M3
MINIMAX_TOKEN=
# MINIMAX_API_URL=https://api.minimaxi.chat/v1
# MINIMAX_MODEL=MiniMax-M3
# Endpoint de búsqueda web (Coding Plan). Default: ${MINIMAX_API_URL}/coding_plan/search
# Si tu plan usa un host distinto para search, podés override-ear la URL completa:
# MINIMAX_SEARCH_URL=https://api.minimax.io/v1/coding_plan/search
